# Auth0 (Regular Web Application, confidential client)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=xxxxxxxx
AUTH0_CLIENT_SECRET=xxxxxxxx
AUTH0_CALLBACK_URL=http://localhost:5173/auth/callback
AUTH0_LOGOUT_REDIRECT_URL=http://localhost:5173/

# Signs our own session cookie (separate from Auth0's tokens). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-value

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=travelbuddy
