# Copy to .env and fill in. .env is gitignored; this file is not.

# Signs the session cookie. Any long random string: `openssl rand -hex 32`
SESSION_SECRET=""

# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="tagalong"

# Auth0 (Regular Web Application, confidential client) — used for .edu email
# verification only; see auth0/ for the Pre User Registration Action.
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
AUTH0_CALLBACK_URL="http://localhost:5173/auth/callback"
AUTH0_LOGOUT_REDIRECT_URL="http://localhost:5173/"
