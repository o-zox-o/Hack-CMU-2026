# Copy to .env and fill in. .env is gitignored; this file is not.

# Signs the session cookie. Any long random string: `openssl rand -hex 32`
SESSION_SECRET=""

# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="tagalong"

# Email notifications (Resend). Optional — without a key, joins just log instead.
# Get one at https://resend.com → API Keys
RESEND_API_KEY=""
# Must be a verified domain to reach anyone; the default sandbox sender only
# delivers to the address that owns the Resend account.
EMAIL_FROM="Tagalong <onboarding@resend.dev>"
